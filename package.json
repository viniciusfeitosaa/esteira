{
  "name": "esteira",
  "version": "0.5.0",
  "private": true,
  "description": "Contagem de comprimidos em esteira — YOLO no PC + UI no browser",
  "scripts": {
    "start": "node server.mjs",
    "http": "node server.mjs --http",
    "test": "node tests/synthetic-bench.mjs && node tests/assist-bench.mjs && node tests/yolo-assist-bench.mjs",
    "test:py": "py -3.12 -m pytest tests -q",
    "eval:samples": "py -3.12 scripts/eval_belt_count.py --videos samples/videos",
    "yolo:demo": "py -3.12 scripts/run_yolo_service.py --source samples/videos/esteira-2026-09-28-1.mp4",
    "dataset:fetch": "py -3.12 scripts/fetch_rice_datasets.py",
    "dataset:pills": "py -3.12 scripts/fetch_pill_datasets.py",
    "train:grain": "py -3.12 scripts/train_grain_yolo.py",
    "train:pill": "py -3.12 scripts/train_pill_yolo.py",
    "yolo:serve": "py -3.12 scripts/run_yolo_service.py --source 0 --direction rtl",
    "yolo:lite": "py -3.12 scripts/run_yolo_service.py --source 0 --direction rtl --lite"
  }
}
